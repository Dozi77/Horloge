# @hub v2sWDvY99ZH3 251e93a612a559473099c9a0ad5c4ff7bfe9f2ed8b66f6635cf3b63fd8dc0e39
# @name    UpdateCheck
# @desc    Appears only when a newer AWTRIX NG release exists
# @author  Blueforcer
# @version 2.0
# @config  hours number "Check every" default=6 min=1 max=24 unit=h help="How often GitHub is asked for the latest release"
# @config  alert bool "Notify once" default=false help="Also show a notification when a new release appears"

class UpdateCheck
  var installed, latest, due, label, lx, ux, ticks, busy, t0

  def init()
    self.installed = self.rank(version())
    self.latest = store.get("latest")
    if type(self.latest) != "string" self.latest = nil end
    self.ux = 9 + max(0, (width() - 9 - text_ink_width("UPDATE")) / 2)
    self.ticks = 0
    self.busy = false
    self.t0 = 0
    self.judge()
  end

  # "1.2.13" -> 1002013, so 1.2.9 sorts below 1.2.13; a "-dev" suffix is ignored.
  def rank(v)
    var m = re.search("(\\d+)\\.(\\d+)\\.?(\\d*)", v)
    if m == nil return 0 end
    return (num(m[1], 0) * 1000 + num(m[2], 0)) * 1000 + num(m[3], 0)
  end

  def judge()
    self.due = self.latest != nil && self.rank(self.latest) > self.installed
    self.label = self.due ? self.latest : version()
    self.lx = 8 + max(0, (width() - 8 - text_ink_width(self.label)) / 2)
  end

  # Only published releases count: a version bump on main before the
  # release and its update files exist is not an update yet.
  def on_body(b, st)
    self.busy = false
    var m = b == nil ? nil : re.search("\"tag_name\": *\"v?([0-9][0-9.]*)", b)
    if m == nil
      self.ticks = 900
      if st != 200 log("UpdateCheck: status " + str(st)) end
      return
    end
    self.latest = m[1]
    store.set("latest", m[1])
    self.judge()
    if self.due && store.get("alert") && store.get("told") != m[1]
      store.set("told", m[1])
      notify({"text": "Update " + m[1], "textColor": 0x00FF60,
              "icon": "data:image/gif;base64,R0lGODdhCAAIAIEAAAAAAAD/YGBgYAAAACwAAAAACAAIAAAIIgABCAwQQKBBAAQPDixokKBDhggdKkxoUMBBiwAEaNwIICAAOw=="})
    end
  end

  def loop()
    if self.ticks <= 0 && !self.busy
      self.busy = true
      self.ticks = int(store.get("hours")) * 3600
      http.get("https://api.github.com/repos/Blueforcer/awtrix-ng/releases/latest",
               / b, st -> self.on_body(b, st), {'find': '"tag_name"', 'keep': 40,
                'headers': {'User-Agent': 'AWTRIX-NG'}})
    end
    self.ticks -= 1
  end

  def should_show()
    self.t0 = now_ms()
    return self.due
  end

  def on_button(btn)
    if btn == "select" && !self.busy
      self.ticks = 0
      return true
    end
  end

  # A light runs down the arrow and each run drops a pixel into the tray;
  # a full tray flashes. Beside it UPDATE and the new version take turns.
  def draw()
    clear()
    if !self.due
      text(1, 6, self.label, 0x404040)
      return
    end
    var t = now_ms()
    var h = (t / 12) % 360
    var b = (t / 80) % 7
    var r = 0
    while r < 6
      var c = hsv(h, 100, r == b ? 100 : (r == b - 1 ? 65 : 40))
      if r < 3 rect_fill(3, r, 2, 1, c) else line(r - 2, r, 9 - r, r, c) end
      r += 1
    end
    var n = (t / 560) % 8
    var tray = n == 7 ? 0x00FF60 : 0x383838
    line(1, 7, 6, 7, tray)
    pixel(1, 6, tray)
    pixel(6, 6, tray)
    if n > 0 && n < 7 line(1, 7, n, 7, 0x00C048) end
    if ((t - self.t0) / 2500) % 2 == 0
      ramp_text(self.ux, 6, "UPDATE", "Rainbow", 0, 0.6)
    else
      text(self.lx, 6, self.label, 0x00FF60)
    end
  end
end

return UpdateCheck()