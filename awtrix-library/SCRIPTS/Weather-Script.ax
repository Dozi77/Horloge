# @hub fGEhP0cZZd6E cc60f184db16c2613ee1dcb8fe44c3da47c36a02bb71b34b7f1481006c3898b2
# @name Weather
# @desc Weather, humidity, 15-hour forecast and moon phase
# @author Hank_the_Tank / Claude
# @version 3.7
# @config lat number "Latitude" default=52.52 min=-90 max=90 step=0.0001
# @config lon number "Longitude" default=13.40 min=-180 max=180 step=0.0001
# @config unit select "Temperature unit" default=C options=C,F
# @config every number "Refresh" default=15 min=15 max=60 unit=min
# @config showhum bool "Show humidity" default=true
# @config hold number "Swap after" default=3 min=1 max=10 unit=s help="How long temperature and humidity each stay before sliding"
# @config hcol color "Humidity colour" default=#31B8DB

class Weather
  var st, fc, label, tcol, wic, mic, mday, ticks, age, traw, busy, period
  var hraw, hlabel, showhum, hold, hcol, t0

  def init()
    # Colour stops: lower bound, colour - interpolated in between
    self.st = [-12, 0xD977DF, -6, 0x9545BC, -1, 0x4B379C, 0, 0xFEC4FF,
               4, 0x31B8DB, 10, 0x31DB8B, 15, 0x6ED228, 21, 0xFFFF28,
               27, 0xF87E27, 32, 0xCF3927, 38, 0xA12527]
    self.fc = []
    self.period = store.get("every") * 60
    self.traw = store.get("temp")
    self.label = self.traw == nil ? nil : self.label_for(self.traw)
    self.tcol = store.get("col", 0x666666)
    self.wic = store.get("icon", "")
    self.mic = ""
    self.mday = -1
    self.ticks = 0
    self.age = 9999
    self.busy = false

    # Humidity - settings are cached here, never read in draw()
    self.hraw = store.get("hum")
    self.hlabel = self.hraw == nil ? nil : self.hum_label(self.hraw)
    self.showhum = store.get("showhum")
    self.hold = int(store.get("hold") * 1000)
    self.hcol = store.get("hcol")
    self.t0 = 0
  end

  def label_for(t)
    # Builds the display string from the raw Celsius temperature,
    # so a C/F switch takes effect right after saving the settings
    var u = store.get("unit")
    var v = u == "F" ? t * 1.8 + 32 : t
    return str(int(v + (v >= 0 ? 0.5 : -0.5))) + (u == "F" ? "F" : "°")
  end

  def hum_label(h)
    # "100%" is wider than the 14 px text slot, so the sign is dropped there
    var v = int(h + 0.5)
    var s = str(v) + "%"
    if text_ink_width(s) > 14 s = str(v) end
    return s
  end

  def on_body(w, status)
    self.busy = false
    if w == nil return end
    var m = re.search("_2m\":([-0-9.]+)", w)
    var c = re.search("code\":(\\d+)", w)
    var h = re.search("_2m\":\\[([^\\]]*)", w)
    var hm = re.search("humidity_2m\":([0-9.]+)", w)
    if m == nil || c == nil || h == nil return end
    var t = num(m[1])
    if t == nil return end
    self.traw = t

    # i == 0 is the current temperature, then the hourly values
    var s = self.st
    var vals = re.matchall("[-0-9.]+", h[1])
    var n = size(vals)
    if n > 15 n = 15 end
    var fc = []
    var i = 0
    while i <= n
      var v = i == 0 ? t : num(vals[i - 1])
      var col = s[1]
      if v > s[0]
        var j = 0
        while j < 20 && v >= s[j + 2]
          j += 2
        end
        if j >= 20
          col = s[21]
        else
          var a = s[j + 1]
          var b = s[j + 3]
          var f = (v - s[j]) * 1.0 / (s[j + 2] - s[j])
          col = rgb(int(a / 65536 % 256 + (b / 65536 % 256 - a / 65536 % 256) * f),
                    int(a / 256 % 256 + (b / 256 % 256 - a / 256 % 256) * f),
                    int(a % 256 + (b % 256 - a % 256) * f))
        end
      end
      if i == 0
        self.tcol = col
      else
        fc.push(col)
      end
      i += 1
    end
    self.fc = fc
    self.label = self.label_for(t)

    # Humidity is optional: a missing value never blocks the temperature
    if hm != nil
      var hv = num(hm[1])
      if hv != nil
        self.hraw = hv
        self.hlabel = self.hum_label(hv)
        store.set("hum", hv)
      end
    end

    var k = int(num(c[1]))
    var ic = "36637"
    if k == 0     ic = "53386"
    elif k <= 2   ic = "2286"
    elif k == 3   ic = "53384"
    elif k <= 48  ic = "17055"
    elif k <= 67  ic = "2720"
    elif k <= 77  ic = "2289"
    elif k <= 82  ic = "49300"
    elif k <= 86  ic = "2289"
    elif k >= 95  ic = "29839"
    end
    self.wic = ic
    self.age = 0

    store.set("temp", self.traw)
    store.set("col", self.tcol)
    store.set("icon", ic)
  end

  def loop()
    var d = day()
    if d != self.mday
      self.mday = d
      var mo = month()
      var a = int((14 - mo) / 12)
      var yy = year() + 4800 - a
      var mm = mo + 12 * a - 3
      var f = (d + int((153 * mm + 2) / 5) + 365 * yy + int(yy / 4) -
               int(yy / 100) + int(yy / 400) - 2483595) / 29.53058867
      f -= int(f)
      var ic = "2317"
      if f < 0.03 || f >= 0.97  ic = "2318"
      elif f < 0.22             ic = "2321"
      elif f < 0.28             ic = "2320"
      elif f < 0.48             ic = "2319"
      elif f < 0.52             ic = "2314"
      elif f < 0.72             ic = "2315"
      elif f < 0.78             ic = "2316"
      end
      self.mic = ic
    end

    self.age += 1
    if self.ticks <= 0 && !self.busy
      self.ticks = self.period
      self.busy = true
      http.get("http://api.open-meteo.com/v1/forecast" +
               "?latitude=" + str(store.get("lat")) +
               "&longitude=" + str(store.get("lon")) +
               "&current=temperature_2m,relative_humidity_2m,weather_code" +
               "&hourly=temperature_2m" +
               "&forecast_hours=15&timeformat=unixtime&timezone=auto",
               / b, st -> self.on_body(b, st),
               {'find': "\"current\":", 'keep': 640})
    end
    self.ticks -= 1
  end

  def on_show()
    # Every appearance starts with the temperature
    self.t0 = now_ms()
  end

  def put(s, y, col)
    # Centres a value in the 14 px slot between the two icons
    text(9 + int((14 - text_ink_width(s)) / 2), y, s, col)
  end

  def draw_values()
    if !self.showhum || self.hlabel == nil
      self.put(self.label, 6, self.tcol)
      return
    end
    var slide = 400                      # ms for one 8 px slide
    var per = self.hold + slide
    var t = now_ms() - self.t0
    var p = t % per
    var a = self.label
    var ac = self.tcol
    var b = self.hlabel
    var bc = self.hcol
    if (t / per) % 2 == 1                # odd phases start from humidity
      a = self.hlabel
      ac = self.hcol
      b = self.label
      bc = self.tcol
    end
    if p < self.hold
      self.put(a, 6, ac)
    else
      # Outgoing value leaves at the top, incoming one rises from below
      var off = (p - self.hold) * 8 / slide
      self.put(a, 6 - off, ac)
      self.put(b, 14 - off, bc)
    end
  end

  def draw()
    clear()
    if self.label == nil
      text(6, 6, "...", 0x666666)
      return
    end
    if !icon(self.wic, 0, 0)
      circle_fill(4, 4, 3, 0xFFCC00)
    end
    self.draw_values()
    if !icon(self.mic, 23, 0)
      circle_fill(27, 4, 3, 0xAAAAAA)
    end
    # Forecast row is drawn after the values so it stays on top while sliding
    var i = 0
    var n = size(self.fc)
    while i < n
      pixel(8 + i, 7, self.fc[i])
      i += 1
    end
    if self.age > 1200
      pixel(width() - 1, height() - 1, 0xFF0000)
    end
  end

  def on_button(btn)
    if btn == "select" self.ticks = 0 end
  end
end

return Weather()